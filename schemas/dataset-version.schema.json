{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "synthetic",
          "target_registry_id",
          "target_schema_version"
        ]
      }
    },
    {
      "if": {
        "required": [
          "target_registry_id"
        ]
      },
      "then": {
        "required": [
          "synthetic",
          "target_schema_version"
        ]
      }
    }
  ],
  "properties": {
    "class_names": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "dataset_index_artifact_id": {
      "pattern": "^[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "dataset_version_id": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "preprocessing": {
      "type": "object"
    },
    "preprocessing_version": {
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "source_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "target_registry_id": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "target_schema_version": {
      "const": 1
    },
    "uri": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "class_names",
    "dataset_version_id",
    "name",
    "preprocessing_version",
    "schema_version",
    "source_manifest_sha256",
    "version"
  ],
  "title": "DatasetVersion",
  "type": "object"
}
