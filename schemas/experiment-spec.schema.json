{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keigo-kaggriculture/schemas/experiment-spec.schema.json",
  "title": "Keigo ExperimentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "candidate_ids", "seeds", "seed_split", "opponents", "simulator", "simulator_version", "configuration", "evaluation_policy", "resource_request", "schema_version"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "seed_split": {"enum": ["development", "validation", "holdout"]},
    "opponents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "simulator": {"type": "string", "minLength": 1},
    "simulator_version": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"},
    "evaluation_policy": {"type": "object"},
    "resource_request": {"type": "object"},
    "schema_version": {"const": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
