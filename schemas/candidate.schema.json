{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keigo-kaggriculture/schemas/candidate.schema.json",
  "title": "Keigo Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "artifact_sha256", "entrypoint", "artifact_uri", "configuration", "candidate_id"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "entrypoint": {"type": "string", "minLength": 1},
    "artifact_uri": {"type": "string"},
    "configuration": {"type": "object"},
    "candidate_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
